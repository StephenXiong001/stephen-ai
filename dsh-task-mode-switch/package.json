{
  "name": "dsh-task-mode-switch",
  "version": "1.0.0",
  "description": "Switch a DSH task's Agent preset (mode) from the composer toolbar — including tasks that have already started. Features AUTO mode that selects a preset based on task content.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "agent-preset",
    "mode-switch",
    "task-mode",
    "mode",
    "composer",
    "plugin"
  ],
  "license": "MIT",
  "author": "XIONG研究员",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StephenXiong001/stephen-ai.git",
    "directory": "dsh-task-mode-switch"
  },
  "bugs": {
    "url": "https://github.com/StephenXiong001/stephen-ai/issues"
  },
  "homepage": "https://github.com/StephenXiong001/stephen-ai/tree/main/dsh-task-mode-switch#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
